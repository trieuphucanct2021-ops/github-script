-- Tạo Frame chính
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 100)
frame.Position = UDim2.new(0.5, -100, 0.5, -50)
frame.BackgroundColor3 = Color3.new(1, 1, 1) -- màu trắng
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Parent = gui

-- Thêm viền cầu vồng
local stroke = Instance.new("UIStroke")
stroke.Thickness = 3
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
stroke.Parent = frame

-- Cập nhật màu viền cầu vồng
local hue = 0
game:GetService("RunService").RenderStepped:Connect(function()
	hue = (hue + 0.01) % 1
	stroke.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
end)

-- Tạo nút
local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 100, 0, 40)
button.Position = UDim2.new(0.5, -50, 0.5, -20)
button.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
button.Text = "OFF"
button.Font = Enum.Font.SourceSansBold
button.TextSize = 24
button.TextColor3 = Color3.new(0, 0, 0)
button.Parent = frame

-- Anti-AFK logic
local connection = nil
local userInput = game:GetService("VirtualUser")

button.MouseButton1Click:Connect(function()
	if button.Text == "OFF" then
		button.Text = "ON"
		connection = player.Idled:Connect(function()
			userInput:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
			wait(1)
			userInput:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
		end)
	else
		button.Text = "OFF"
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
end)

